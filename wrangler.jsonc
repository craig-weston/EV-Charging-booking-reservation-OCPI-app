// Cloudflare Workers deployment (Workers Builds from Git, or `npx wrangler deploy`).
// Runtime settings (SUPABASE_URL, OCPI_*, …) and secrets (SUPABASE_ANON_KEY,
// SUPABASE_SERVICE_ROLE_KEY, DATA_ENCRYPTION_KEY) are set in the Cloudflare dashboard:
// Worker → Settings → Variables and Secrets. keep_vars stops a deploy from removing them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "depotcharge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app uses hash routes (#/book, #/pass/…), so any other path really is missing: answer
    // 404 with dist/404.html instead of the app (scanners probing /.env, /wp-admin… get a 404).
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ocpi/*", "/sim/*"]
  },
  "keep_vars": true,
  // Rate limits shared by every isolate in a Cloudflare location (Workers Rate Limiting, wrangler
  // 4.36+). Per client IP; the in-memory limiter in server/security.ts still applies as well.
  // namespace_id must be unique in your Cloudflare account; change it if another Worker uses it.
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "41001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_OCPI", "namespace_id": "41002", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "41003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_OCPI_AUTH", "namespace_id": "41004", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
