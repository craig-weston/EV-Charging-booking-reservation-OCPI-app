// Cloudflare Workers deployment (Workers Builds from Git, or `npx wrangler deploy`).
// Runtime settings (SUPABASE_URL, OCPI_*, …) and secrets (SUPABASE_ANON_KEY,
// SUPABASE_SERVICE_ROLE_KEY, DATA_ENCRYPTION_KEY) are set in the Cloudflare dashboard:
// Worker → Settings → Variables and Secrets. keep_vars stops a deploy from removing them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "depotcharge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ocpi/*", "/sim/*"]
  },
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
